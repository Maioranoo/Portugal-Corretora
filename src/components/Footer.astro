---
import { Image } from 'astro:assets';
import logoBranco from '../assets/brand/logo-branco.png';
import { PRODUCTS } from '../content/products';
import { COMPANY } from '../content/site';
import { buildGenericMessage, buildWhatsAppUrl } from '../lib/whatsapp';
import Icon from './Icon.astro';

const waUrl = buildWhatsAppUrl(COMPANY.whatsapp, buildGenericMessage());
const year = new Date().getFullYear();
---
<footer class="footer on-brand">
  <svg class="footer__meridian" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M-20 118 C 360 10, 1080 10, 1460 118" />
    <path d="M-20 118 C 420 44, 1020 44, 1460 118" />
  </svg>

  <div class="container footer__grid">
    <div class="footer__brand">
      <Image src={logoBranco} alt="Portugal Corretora de Seguros" width={180} widths={[180, 360]} sizes="180px" />
      <p>Corretora registrada na SUSEP nº {COMPANY.susep}</p>
      <a class="button button--wa-outline" href={waUrl} target="_blank" rel="noopener" data-wa-contact data-wa-context="Rodapé">
        <Icon name="whatsapp" size={20} />
        Falar no WhatsApp
      </a>
    </div>

    <nav class="footer__col" aria-label="Seguros">
      <h2>Seguros</h2>
      <ul>
        {PRODUCTS.map((p) => (
          <li><a href={`/${p.slug}`}>{p.name}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer__col">
      <h2>Atendimento</h2>
      <ul class="footer__contact">
        <li><Icon name="clock" size={18} />{COMPANY.hoursLabel}</li>
        <li><Icon name="phone" size={18} /><a href={waUrl} target="_blank" rel="noopener" data-wa-contact data-wa-context="Rodapé">{COMPANY.whatsappDisplay}</a></li>
        <li><Icon name="arrow" size={18} /><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></li>
        <li>
          <Icon name="map" size={18} />
          <a href={COMPANY.address.mapsUrl} target="_blank" rel="noopener">
            {COMPANY.address.street}, {COMPANY.address.district}, {COMPANY.address.city} - {COMPANY.address.state}, {COMPANY.address.zip}
          </a>
        </li>
      </ul>
      <a class="footer__client" href="/ja-sou-cliente">Já sou cliente</a>
    </div>

    <div class="footer__col">
      <h2>Siga a Portugal</h2>
      <ul class="footer__social">
        <li><a href={COMPANY.social.instagram} target="_blank" rel="noopener" aria-label="Instagram da Portugal Corretora"><Icon name="instagram" size={26} /></a></li>
        <li><a href={COMPANY.social.facebook} target="_blank" rel="noopener" aria-label="Facebook da Portugal Corretora"><Icon name="facebook" size={26} /></a></li>
      </ul>
      <a class="footer__review" href="/avaliar"><Icon name="star" size={18} />Avalie-nos no Google</a>
    </div>
  </div>

  <div class="container footer__legal">
    <p>{COMPANY.legalName} · CNPJ {COMPANY.cnpj}</p>
    <ul>
      <li><a href="/privacidade">Política de Privacidade</a></li>
      <li><button type="button" data-cookie-preferences>Preferências de cookies</button></li>
    </ul>
    <p>© {year} {COMPANY.name}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: var(--section-y);
    padding: calc(var(--space-9) + var(--space-4)) 0 var(--space-6);
    background: var(--color-brand);
    color: var(--color-meridian);
    font-size: var(--step--1);
  }

  .footer__meridian {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 96px;
    fill: none;
    stroke: var(--color-meridian);
    stroke-width: 1.5;
    opacity: 0.35;
    vector-effect: non-scaling-stroke;
  }

  .footer__meridian path {
    vector-effect: non-scaling-stroke;
  }

  .footer a:not(.button) {
    color: var(--color-on-brand);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1.4fr 1fr;
    gap: var(--space-7);
  }

  .footer__brand {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    align-content: start;
  }

  .footer__brand img {
    width: 180px;
    height: auto;
  }

  .footer h2 {
    margin-bottom: var(--space-4);
    color: var(--color-on-brand);
    font-size: var(--step-0);
  }

  .footer ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .footer__col a {
    display: inline-block;
    padding-block: 2px;
  }

  .footer__contact li {
    display: grid;
    grid-template-columns: 18px 1fr;
    gap: var(--space-2);
    align-items: start;
  }

  .footer__contact :global(svg),
  .footer__review :global(svg) {
    margin-top: 3px;
    color: var(--color-meridian);
  }

  .footer__client,
  .footer__review {
    margin-top: var(--space-4);
    display: inline-flex !important;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-weight: 700;
  }

  .footer__social {
    grid-auto-flow: column;
    justify-content: start;
  }

  .footer__social a {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgb(214 226 243 / 0.4);
    border-radius: var(--radius);
  }

  .footer__social a:hover {
    background: rgb(214 226 243 / 0.12);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid rgb(214 226 243 / 0.25);
  }

  .footer__legal ul {
    grid-auto-flow: column;
    gap: var(--space-5);
  }

  .footer__legal a,
  .footer__legal button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-on-brand);
    font-size: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer__legal button {
    padding: 0;
    border: 0;
    background: none;
  }

  @media (max-width: 1080px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .footer__legal,
    .footer__legal ul {
      display: grid;
      grid-auto-flow: row;
      justify-content: start;
      gap: var(--space-2);
    }
  }
</style>
