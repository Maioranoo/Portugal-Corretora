---
import { COMPANY, HOME } from '../content/site';
import { buildGenericMessage, buildWhatsAppUrl } from '../lib/whatsapp';
import Icon from './Icon.astro';
import Orbit from './Orbit.astro';
import TrustBadges from './TrustBadges.astro';

const waUrl = buildWhatsAppUrl(COMPANY.whatsapp, buildGenericMessage());
---
<section class="hero" aria-labelledby="hero-titulo">
  <div class="container hero__grid">
    <div class="hero__copy">
      <h1 id="hero-titulo">{HOME.hero.title}</h1>
      <p class="hero__subtitle">{HOME.hero.subtitle}</p>
      <div class="hero__actions">
        <a class="button button--primary" href="#contato">Falar com um especialista</a>
        <a class="button button--wa-outline" href={waUrl} target="_blank" rel="noopener" data-wa-contact data-wa-context="Topo da home">
          <Icon name="whatsapp" size={20} />
          Falar no WhatsApp
        </a>
      </div>
      <TrustBadges />
    </div>
    <div class="hero__orbit" id="produtos-rapido">
      <Orbit />
    </div>
  </div>
</section>

<style>
  .hero {
    overflow-x: clip;
    padding: clamp(1rem, 0.5rem + 1.5vw, 2.5rem) 0 clamp(2rem, 1rem + 3vw, 4rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-6);
    align-items: start;
  }

  .hero__copy {
    grid-column: 1 / span 7;
    display: grid;
    gap: var(--space-5);
  }

  .hero h1 {
    font-size: clamp(2.125rem, 1.2rem + 2.9vw, 3.375rem);
    font-weight: 850;
    color: var(--color-brand);
    letter-spacing: -0.015em;
    word-spacing: 0.06em;
  }

  .hero__subtitle {
    max-width: 44ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .hero__copy :global(.badges) {
    margin-top: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .hero__orbit {
    grid-column: 8 / span 5;
    /* o globo avança até a borda direita da tela */
    margin-right: calc(-1 * (var(--gutter) + max(0px, (100vw - var(--container)) / 2)));
    margin-left: calc(-1 * var(--space-6));
    margin-top: calc(-1 * var(--space-7));
  }

  .hero__copy {
    padding-top: var(--space-6);
  }

  @media (max-width: 900px) {
    .hero__copy,
    .hero__orbit {
      grid-column: 1 / -1;
    }

    .hero__copy {
      padding-top: 0;
    }


    .hero__orbit {
      margin-top: var(--space-4);
      margin-left: 0;
      margin-right: calc(-1 * var(--gutter));
      max-width: 600px;
      justify-self: end;
      width: calc(100% + var(--gutter));
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: var(--space-5);
    }

    .hero__copy {
      gap: var(--space-4);
    }

    .hero h1 {
      font-size: 2.125rem;
      line-height: 1.06;
    }

    .hero__subtitle {
      font-size: var(--step-0);
    }

    .hero__actions {
      display: grid;
      margin-top: 0;
    }

    .hero__actions .button {
      width: 100%;
    }

    .hero__copy :global(.badges) {
      margin-top: 0;
      padding-top: var(--space-4);
    }
  }
</style>
