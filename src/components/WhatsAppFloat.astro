---
import { COMPANY } from '../content/site';
import { buildGenericMessage, buildWhatsAppUrl } from '../lib/whatsapp';
import Icon from './Icon.astro';

interface Props {
  context?: string;
}
const { context } = Astro.props;
const href = buildWhatsAppUrl(COMPANY.whatsapp, buildGenericMessage(context));
---
<a
  class="wa-float"
  data-wa-contact
  data-wa-context={context ?? 'Botão flutuante'}
  href={href}
  target="_blank"
  rel="noopener"
  aria-label="Falar pelo WhatsApp"
>
  <Icon name="whatsapp" size={28} />
  <span class="wa-float__label">Falar no WhatsApp</span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: var(--space-5);
    bottom: var(--space-5);
    z-index: 30;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: var(--radius-pill);
    background: var(--color-whatsapp);
    color: var(--color-whatsapp-ink);
    box-shadow: 0 6px 20px rgb(6 48 26 / 0.28);
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out);
  }

  .wa-float:hover {
    background: var(--color-whatsapp-hover);
  }

  @media (hover: hover) and (pointer: fine) {
    .wa-float:hover {
      transform: translateY(-2px);
    }
  }

  .wa-float__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  /* No celular: o mesmo balão, um pouco menor, acima do aviso de cookies enquanto ele estiver aberto
     e respeitando a borda inferior do iPhone */
  @media (max-width: 640px) {
    .wa-float {
      right: var(--space-4);
      bottom: calc(var(--space-4) + var(--cookie-h, 0px) + env(safe-area-inset-bottom));
      width: 56px;
      height: 56px;
    }
  }
</style>
