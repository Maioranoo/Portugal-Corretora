---
import type { Item } from '../content/products';
import { SECTIONS } from '../content/site';
import Icon, { type IconName } from './Icon.astro';

interface Props {
  items: readonly Item[];
}
const { items } = Astro.props;
const ICONS: IconName[] = ['whatsapp', 'shield', 'check', 'star'];
---
<section class="section section--surface diff" aria-labelledby="diferenciais-titulo">
  <div class="container diff__grid">
    <div data-reveal>
      <h2 class="section__title" id="diferenciais-titulo">{SECTIONS.differentials.title}</h2>
      <p class="section__lead">{SECTIONS.differentials.lead}</p>
    </div>
    <ul class="diff__list">
      {
        items.map((item, i) => (
          <li data-reveal>
            <Icon name={ICONS[i % ICONS.length]} size={26} />
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .diff__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-8);
    align-items: start;
  }

  .diff__list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6) var(--space-6);
  }

  .diff__list li {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 2px solid var(--color-brand);
  }

  .diff__list :global(svg) {
    color: var(--color-brand);
  }

  .diff__list h3 {
    font-size: var(--step-1);
    color: var(--color-ink);
  }

  .diff__list p {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  @media (max-width: 900px) {
    .diff__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 560px) {
    .diff__list {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
