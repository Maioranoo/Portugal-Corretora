---
import { COMPANY } from '../content/site';
import Icon from './Icon.astro';

interface Props {
  tone?: 'light' | 'brand';
}
const { tone = 'light' } = Astro.props;
---
<ul class:list={['badges', `badges--${tone}`]} aria-label="Por que confiar na Portugal">
  <li>
    <Icon name="shield" size={22} />
    <span><strong>SUSEP {COMPANY.susep}</strong> Corretora registrada</span>
  </li>
  <li>
    <Icon name="clock" size={22} />
    <span><strong>{COMPANY.yearsLabel}</strong> de mercado</span>
  </li>
  <li>
    <Icon name="star" size={22} />
    <span>
      <strong>{COMPANY.google.ratingLabel} no Google</strong>
      <a href={COMPANY.google.reviewsUrl} target="_blank" rel="noopener">{COMPANY.google.count} avaliações</a>
    </span>
  </li>
</ul>

<style>
  .badges {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .badges li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--step--1);
    line-height: 1.35;
    color: var(--color-text-muted);
  }

  .badges :global(svg) {
    flex: none;
    color: var(--color-brand);
    margin-top: 1px;
  }

  .badges span {
    display: flex;
    flex-direction: column;
  }

  .badges strong {
    color: var(--color-ink);
    font-weight: 700;
    font-size: var(--step-0);
    font-stretch: var(--width-display);
  }

  .badges a {
    color: inherit;
  }

  .badges--brand li,
  .badges--brand a {
    color: var(--color-meridian);
  }

  .badges--brand strong,
  .badges--brand :global(svg) {
    color: var(--color-on-brand);
  }

  @media (max-width: 420px) {
    .badges {
      gap: var(--space-2);
    }

    .badges li {
      flex-direction: column;
      gap: var(--space-1);
    }

    .badges strong {
      font-size: var(--step--1);
    }
  }
</style>
