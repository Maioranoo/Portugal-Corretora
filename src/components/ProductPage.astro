---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Faq from './Faq.astro';
import Guide from './Guide.astro';
import Icon from './Icon.astro';
import InsurerLogos from './InsurerLogos.astro';
import LeadForm from './LeadForm.astro';
import RelatedLinks from './RelatedLinks.astro';
import Reviews from './Reviews.astro';
import Steps from './Steps.astro';
import TrustBadges from './TrustBadges.astro';
import type { PageContent } from '../content/products';
import type { ProductSlug } from '../content/product-fields';
import { COMPANY, PRODUCT_PAGE } from '../content/site';
import { breadcrumbNode, faqNode, serviceNode, type Crumb } from '../lib/schema';
import { buildGenericMessage, buildWhatsAppUrl } from '../lib/whatsapp';

interface Props {
  page: PageContent;
  formProduct: ProductSlug;
  formPreset?: Readonly<Record<string, string>>;
  breadcrumbs: readonly Crumb[];
}
const { page, formProduct, formPreset, breadcrumbs } = Astro.props;
const path = `/${page.slug}`;
const waUrl = buildWhatsAppUrl(COMPANY.whatsapp, buildGenericMessage(page.name));
const schema = [
  breadcrumbNode(breadcrumbs, path),
  serviceNode({ name: page.name, path, description: page.seo.description }),
  faqNode(page.faqs, path),
];
---
<BaseLayout title={page.seo.title} description={page.seo.description} path={path} productName={page.name} simpleHeader schema={schema}>
  <section class="p-hero" aria-labelledby="produto-titulo">
    <div class="container p-hero__grid">
      <div class="p-hero__copy">
        <Breadcrumbs items={breadcrumbs} />
        {page.badge && <p class="p-hero__badge"><Icon name="star-fill" size={16} />{page.badge}</p>}
        <h1 id="produto-titulo">{page.hero.title}</h1>
        <p class="p-hero__subtitle">{page.hero.subtitle}</p>
        <TrustBadges />
      </div>
      <div id="contato" class="p-hero__form">
        <LeadForm product={formProduct} preset={formPreset} />
      </div>
    </div>
  </section>

  <section class="section section--surface coverages" aria-labelledby="coberturas-titulo">
    <div class="container">
      <div class="section__head" data-reveal>
        <h2 class="section__title" id="coberturas-titulo">{page.coveragesTitle}</h2>
      </div>
      <ul class="coverages__list">
        {
          page.coverages.map((c) => (
            <li data-reveal>
              <span class="coverages__check"><Icon name="check" size={20} /></span>
              <div>
                <h3>{c.title}</h3>
                <p>{c.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {page.guide && <Guide guide={page.guide} id={`guia-${page.slug}`} />}

  <section class="section audiences" aria-labelledby="publico-titulo">
    <div class="container audiences__grid">
      <h2 class="section__title" id="publico-titulo" data-reveal>{PRODUCT_PAGE.audiencesTitle}</h2>
      <ul class="audiences__list">
        {
          page.audiences.map((a) => (
            <li data-reveal>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Steps steps={page.steps} title={PRODUCT_PAGE.stepsTitle} />
  <InsurerLogos
    ids={page.insurers}
    title={page.insurersTitle ?? `${PRODUCT_PAGE.insurersTitle} ${page.name}`}
    lead={page.insurersLead ?? PRODUCT_PAGE.insurersLead}
  />
  <Reviews />
  <Faq faqs={page.faqs} title={`${PRODUCT_PAGE.faqTitle} ${page.name}`} name={`faq-${page.slug}`} />
  {page.related && page.related.length > 0 && <RelatedLinks links={page.related} />}

  <section class="section p-close" aria-labelledby="fechamento-titulo">
    <div class="container p-close__inner" data-reveal>
      <h2 class="section__title" id="fechamento-titulo">{PRODUCT_PAGE.closeTitle}</h2>
      <p class="section__lead">{PRODUCT_PAGE.closeLead}</p>
      <div class="p-close__actions">
        <a class="button button--primary" href="#contato">Falar com um especialista</a>
        <a class="button button--wa-outline" href={waUrl} target="_blank" rel="noopener" data-wa-contact data-wa-context={page.name}>
          <Icon name="whatsapp" size={20} />
          Falar no WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .p-hero {
    padding: clamp(1.5rem, 1rem + 2vw, 3.5rem) 0 var(--section-y);
  }

  .p-hero__grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--space-8);
    align-items: start;
  }

  .p-hero__copy {
    display: grid;
    gap: var(--space-5);
    padding-top: var(--space-5);
  }

  .p-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    justify-self: start;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-globe-disc);
    color: var(--color-brand);
    font-weight: 700;
    font-size: var(--step--1);
  }

  .p-hero h1 {
    font-size: clamp(2.125rem, 1.2rem + 2.9vw, 3.375rem);
    font-weight: 850;
    color: var(--color-brand);
    letter-spacing: -0.015em;
    word-spacing: 0.06em;
  }

  .p-hero__subtitle {
    max-width: 48ch;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .p-hero__copy :global(.badges) {
    margin-top: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .coverages__list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6) var(--space-6);
  }

  .coverages__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  .coverages__check {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-globe-disc);
    color: var(--color-brand);
  }

  .coverages__list h3,
  .audiences__list h3 {
    font-size: var(--step-1);
    color: var(--color-ink);
  }

  .coverages__list p,
  .audiences__list p {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }

  .audiences__grid {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: var(--space-8);
    align-items: start;
  }

  .audiences__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .audiences__list li {
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius);
    background: var(--color-globe-disc);
  }

  .p-close {
    text-align: center;
  }

  .p-close__inner {
    display: grid;
    justify-items: center;
  }

  .p-close__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  @media (max-width: 1080px) {
    .coverages__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .p-hero__grid,
    .audiences__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .p-hero__copy {
      padding-top: 0;
    }
  }

  @media (max-width: 640px) {
    .coverages__list {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .p-close__actions {
      display: grid;
      width: 100%;
    }
  }
</style>
