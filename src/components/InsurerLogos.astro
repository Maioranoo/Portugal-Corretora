---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { INSURERS, type InsurerId } from '../content/insurers';
import { SECTIONS } from '../content/site';

interface Props {
  ids?: readonly InsurerId[];
  title?: string;
  lead?: string;
}
const {
  ids,
  title = SECTIONS.insurers.title,
  lead = SECTIONS.insurers.lead,
} = Astro.props;

// Logos oficiais em src/assets/insurers/<id>[.vN].svg|png (fontes em FONTES.md). Sem arquivo, o nome aparece em texto.
// O sufixo .vN troca o endereço do arquivo quando o logo muda, para o navegador não mostrar a versão guardada.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/insurers/*.{svg,png}', { eager: true });
const logoFor = (id: InsurerId) =>
  Object.entries(files).find(([path]) => path.split('/').pop()?.split('.')[0] === id)?.[1].default;

const list = (ids ? INSURERS.filter((i) => ids.includes(i.id)) : INSURERS).map((i) => ({ ...i, logo: logoFor(i.id) }));
---
<section class="section insurers" aria-labelledby="seguradoras-titulo">
  <div class="container">
    <div class="section__head insurers__head">
      <h2 class="section__title" id="seguradoras-titulo">{title}</h2>
      <p class="section__lead">{lead}</p>
    </div>
    <ul class="insurers__grid" data-count={list.length}>
      {
        list.map((i) => (
          <li data-insurer={i.id}>
            {i.logo ? (
              <Image src={i.logo} alt={i.name} height={88} class="insurers__logo" />
            ) : (
              <span class="insurers__name">{i.name}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .insurers__head {
    text-align: center;
  }

  .insurers__head .section__title,
  .insurers__head .section__lead {
    margin-inline: auto;
  }

  /* Flex centralizado: linhas incompletas (11, 3 ou 2 seguradoras) ficam no meio, sem célula vazia */
  .insurers__grid {
    --cols: 6;
    list-style: none;
    padding: 0 1px 1px 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }

  .insurers__grid li {
    display: grid;
    place-items: center;
    flex: 0 0 calc(100% / var(--cols));
    min-height: 104px;
    margin: 0 -1px -1px 0;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
  }

  /* Todos os logos na mesma caixa (até 132x44): largos encostam na largura, quadrados na altura */
  .insurers__grid :global(.insurers__logo) {
    width: min(132px, 100%);
    height: 44px;
    object-fit: contain;
    filter: grayscale(1) contrast(1.15);
    opacity: 0.8;
    transition: filter var(--duration) var(--ease-out), opacity var(--duration) var(--ease-out);
  }

  /* O logo da Yelum é amarelo; em escala de cinza ficaria apagado demais */
  .insurers__grid [data-insurer='yelum'] :global(.insurers__logo) {
    filter: grayscale(1) brightness(0.55) contrast(1.3);
  }

  @media (hover: hover) {
    .insurers__grid li:hover :global(.insurers__logo) {
      filter: none;
      opacity: 1;
    }
  }

  .insurers__name {
    font-weight: 800;
    font-stretch: var(--width-display);
    font-size: var(--step-1);
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.15;
  }

  @media (max-width: 1080px) {
    .insurers__grid {
      --cols: 4;
    }
  }

  @media (max-width: 640px) {
    .insurers__grid {
      --cols: 2;
    }

    .insurers__grid li {
      min-height: 88px;
    }
  }
</style>
