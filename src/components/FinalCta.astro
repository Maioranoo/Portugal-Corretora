---
import type { ProductSlug } from '../content/product-fields';
import { COMPANY, SECTIONS } from '../content/site';
import { buildGenericMessage, buildWhatsAppUrl } from '../lib/whatsapp';
import Icon from './Icon.astro';

interface Props {
  product?: ProductSlug;
  productName?: string;
}
const { productName } = Astro.props;
const waUrl = buildWhatsAppUrl(COMPANY.whatsapp, buildGenericMessage(productName));
---
<section class="section final" id="contato" aria-labelledby="contato-titulo">
  <div class="container final__grid">
    <div class="final__text">
      <h2 class="section__title" id="contato-titulo">{SECTIONS.contact.title}</h2>
      <p class="section__lead">{SECTIONS.contact.lead}</p>
      <a class="button button--wa-outline" href={waUrl} target="_blank" rel="noopener" data-wa-contact data-wa-context="Chamada final">
        <Icon name="whatsapp" size={20} />
        Falar no WhatsApp
      </a>
    </div>
    <div class="final__form">
      <slot />
    </div>
  </div>
</section>

<style>
  .final__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-8);
    align-items: start;
  }

  .final__text {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .final__text .section__lead {
    margin-top: 0;
  }

  .final__form:empty {
    display: none;
  }

  @media (max-width: 900px) {
    .final__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
