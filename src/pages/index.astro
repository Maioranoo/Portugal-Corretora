---
import About from '../components/About.astro';
import ClientStrip from '../components/ClientStrip.astro';
import Differentials from '../components/Differentials.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Hero from '../components/Hero.astro';
import InsurerLogos from '../components/InsurerLogos.astro';
import LeadForm from '../components/LeadForm.astro';
import ProductGrid from '../components/ProductGrid.astro';
import Reviews from '../components/Reviews.astro';
import Steps from '../components/Steps.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PRODUCTS } from '../content/products';
import { DIFFERENTIALS, GENERAL_FAQS, HOME, HOME_STEPS, SECTIONS } from '../content/site';

---
<BaseLayout title={HOME.seo.title} description={HOME.seo.description} shareTitle={HOME.seo.shareTitle} path="/">
  <Hero />
  <ProductGrid products={PRODUCTS} />
  <Steps steps={HOME_STEPS} title={SECTIONS.steps.title} />
  <Differentials items={DIFFERENTIALS} />
  <InsurerLogos />
  <Reviews />
  <About />
  <ClientStrip />
  <Faq faqs={GENERAL_FAQS} name="faq-home" />
  <FinalCta>
    <LeadForm />
  </FinalCta>
</BaseLayout>
