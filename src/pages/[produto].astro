---
import type { GetStaticPaths } from 'astro';
import ProductPage from '../components/ProductPage.astro';
import { PRODUCTS, type Product } from '../content/products';

export const getStaticPaths = (() =>
  PRODUCTS.map((product) => ({ params: { produto: product.slug }, props: { product } }))) satisfies GetStaticPaths;

interface Props {
  product: Product;
}
const { product } = Astro.props;
---
<ProductPage
  page={product}
  formProduct={product.slug}
  breadcrumbs={[{ name: 'Início', path: '/' }, { name: product.name, path: `/${product.slug}` }]}
/>
