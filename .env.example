# Chave da API do Resend (painel do Resend → API Keys). Sem ela, em desenvolvimento o e-mail é só exibido no terminal.
RESEND_API_KEY=
# Quem recebe os pedidos (padrão: atendimento@portugalcorretora.com.br). Tire o # só se for mudar.
# LEAD_TO_EMAIL=
# Remetente (padrão: site@portugalcorretora.com.br); precisa ser de um domínio verificado no Resend
# LEAD_FROM_EMAIL=
# ID do Pixel da Meta (Gerenciador de Eventos). Vazio = Pixel desligado.
PUBLIC_META_PIXEL_ID=
